# Copy to .env (or run `npm run setup`, which generates secrets for you).

# SQLite database file (relative to the web/ folder)
DATABASE_URL="file:./prisma/dev.db"

# 32-byte base64 key for AES-256-GCM encryption of sensitive fields (notes, AI chats, 2FA secrets).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: losing/changing this key makes previously encrypted fields unreadable.
APP_ENCRYPTION_KEY=""

# Public base URL (used in password-reset links).
APP_URL="http://localhost:3000"

# ── AI (optional). Without a key, AI features show an "unavailable" state; nothing is faked. ──
ANTHROPIC_API_KEY=""
# Optional model override (defaults in src/server/ai/provider.ts)
AI_MODEL=""
# Max AI requests per user per hour (cost control)
AI_HOURLY_LIMIT="40"

# ── Food data (optional) ──
# USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup). Enables USDA search results.
USDA_API_KEY=""
# Open Food Facts needs no key. Set to "false" to disable external barcode/branded lookups.
OPEN_FOOD_FACTS_ENABLED="true"

# ── Email (optional). Without SMTP, password-reset links are printed to the server log in development only. ──
SMTP_URL=""
EMAIL_FROM=""
